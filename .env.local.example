NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: https://console-backend-two.vercel.app

# Gmail SMTP account used by /api/send-invoice-email to email booking
# confirmations. EMAIL_PASSWORD is a Gmail "app password" (Google Account >
# Security > App passwords), not the account's login password. These are
# server-only (no NEXT_PUBLIC_ prefix) — never exposed to the browser.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
COMPANY_EMAIL=company-inbox@example.com
